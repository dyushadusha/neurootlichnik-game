# =============================================================
# Переменные окружения для api/submit-brief.js
# Скопируйте этот файл в .env (или впишите те же переменные в
# настройках проекта на Vercel → Settings → Environment Variables) —
# сам .env коммитить в git не нужно, там секретный токен.
# =============================================================

# 1. Напишите @BotFather в Telegram → /newbot → следуйте подсказкам.
#    В ответ он пришлёт токен вида 123456789:AA...
TELEGRAM_BOT_TOKEN=

# 2. Куда слать заявки — id чата:
#    - для личного чата с собой: напишите боту @userinfobot, он пришлёт ваш id;
#    - для группы/канала: добавьте туда бота и возьмите id чата
#      (например, через @getidsbot).
TELEGRAM_CHAT_ID=

# 3. (необязательно) Домен вашего сайта — ограничивает, с каких сайтов
#    можно дёргать эту функцию. Если оставить пустым, разрешены любые.
ALLOWED_ORIGIN=https://neurootlichnik.ru
