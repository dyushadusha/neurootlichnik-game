# Скопируйте этот файл в tools/outreach/.env и заполните своими значениями.
# .env в git не попадает (см. .gitignore).

# --- Источники лидов (нужен хотя бы один) ---

# 2GIS Catalog API — бесплатный ключ для приложений: https://dev.2gis.ru/
TWOGIS_API_KEY=

# Yandex Geosearch API (продукт "Search API" / Геосправочник):
# https://developer.tech.yandex.ru/services
YANDEX_MAPS_API_KEY=

# --- SMTP для отправки писем (нужен только для send-emails.js --send) ---

# Пример для Яндекс.Почты: SMTP_HOST=smtp.yandex.ru, SMTP_PORT=465, SMTP_SECURE=true
# Пример для Gmail:        SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
# В обоих случаях SMTP_PASS — это пароль приложения, а не пароль от аккаунта.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Имя и адрес отправителя, которые увидит получатель
FROM_NAME=Нейро Отличник
FROM_EMAIL=

# Куда будут приходить ответы, если отличается от FROM_EMAIL
REPLY_TO=info@neurootlichnik.ru
