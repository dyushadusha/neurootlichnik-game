# Скопируйте этот файл в tools/outreach/.env и заполните своими значениями.
# .env в git не попадает (см. .gitignore).

# --- Источники лидов (нужен хотя бы один) ---

# 2GIS Catalog API — бесплатный ключ для приложений: https://dev.2gis.ru/
TWOGIS_API_KEY=

# Yandex Geosearch API (продукт "Search API" / Геосправочник):
# https://developer.tech.yandex.ru/services
YANDEX_MAPS_API_KEY=

# --- SMTP для отправки писем (нужен только для send-emails.js --send) ---

# Пример для Яндекс.Почты: SMTP_HOST=smtp.yandex.ru, SMTP_PORT=465, SMTP_SECURE=true
# Пример для Gmail:        SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
# В обоих случаях SMTP_PASS — это пароль приложения, а не пароль от аккаунта.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Имя и адрес отправителя, которые увидит получатель
FROM_NAME=Нейро Отличник
FROM_EMAIL=

# Куда будут приходить ответы, если отличается от FROM_EMAIL
REPLY_TO=info@neurootlichnik.ru

# --- Telegram-бот (tools/outreach/bot.js) — управление с телефона ---

# Токен от @BotFather (команда /newbot)
TELEGRAM_BOT_TOKEN=

# Ваш числовой Telegram ID через запятую (узнать — написать @userinfobot).
# КРИТИЧЕСКИ ВАЖНО: без этого бот не ответит вообще никому — это защита от
# того, что кто-то посторонний, узнав имя бота, начнёт слать письма от
# имени студии или увидит собранные контакты компаний.
TELEGRAM_ALLOWED_USER_IDS=

# Сколько писем максимум отправлять за один тап "Отправить" в боте
# (независимо от --limit, если запускаете send-emails.js вручную из консоли)
BOT_SEND_LIMIT=15
# Пауза между письмами при отправке из бота, мс
BOT_SEND_DELAY_MS=15000
# Суммарный лимит писем в сутки (складывается с ручными запусками send-emails.js)
BOT_DAILY_CAP=40
# Сколько лидов проверять на email за один тап "Найти email" (это самый
# медленный шаг — не делайте больше 40-60, чтобы бот не завис надолго)
BOT_ENRICH_LIMIT=40
# Сколько страниц выдачи забирать на город+категорию при "Найти лиды" из бота
BOT_DISCOVER_MAX_PAGES=2

# "Рабочие часы" — вне них бот перед реальной отправкой покажет
# предупреждение (но не заблокирует, если всё же нужно отправить сейчас)
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=19
BUSINESS_TZ=Europe/Moscow
